          "type": "string",
          "optional": true,
          "description": "Lead email address"
        },
        "phone": {
          "type": "string",
          "optional": true,
          "description": "Lead phone number"
        },
        "message": {
          "type": "string",
          "optional": true,
          "description": "Initial contact message"
        }
