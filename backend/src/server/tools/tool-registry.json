    {
      "id": "server.qualifyLead",
      "name": "Qualify Lead",
      "description": "Qualifies a lead by updating its classification status. Use this when the user wants to qualify or update the status of a lead from TikTok, Facebook, or Instagram.",
      "execution": "server",
      "category": "leads",
      "parameters": {
        "leadId": {
          "type": "string",
          "required": true,
          "description": "The lead ID to qualify"
        },
        "source": {
          "type": "string",
          "required": true,
          "enum": ["tiktok", "facebook", "instagram"],
          "description": "Source platform of the lead"
        },
        "classification": {
          "type": "string",
          "required": true,
          "enum": ["hot", "warm", "cold", "qualified", "unqualified"],
          "description": "New classification for the lead"
        },
        "notes": {
          "type": "string",
          "optional": true,
          "description": "Qualification notes"
        }
      },
      "returns": {
        "success": "boolean",
        "leadId": "string",
        "message": "string"
      },
      "ui": {
        "actionButton": "Qualify Lead",
        "icon": "check-circle"
      }
    },
    {
      "id": "server.contactLead",
      "name": "Contact Lead",
      "description": "Initiates contact with a lead via the specified method. Use this when the user wants to reach out to a lead.",
      "execution": "server",
      "category": "leads",
      "parameters": {
        "leadId": {
          "type": "string",
          "required": true,
          "description": "The lead ID to contact"
        },
        "source": {
          "type": "string",
          "required": true,
          "enum": ["tiktok", "facebook", "instagram"],
          "description": "Source platform of the lead"
        },
        "contactMethod": {
          "type": "string",
          "required": true,
