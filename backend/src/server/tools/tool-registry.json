{
  "version": "1.0.0",
  "metadata": {
    "description": "Tool registry with MCP Apps UI metadata",
    "uiEnabled": true
  },
  "tools": [
    {
      "id": "client.getTime",
      "name": "Get Current Time",
      "description": "Gets the user's current local time from their device. Use this when the user asks about the current time, what time it is, or needs to know their local time. Returns localTime (formatted string), timezone identifier, and UTC time.",
      "execution": "client",
      "category": "temporal",
      "parameters": {
        "format": {
          "type": "string",
          "enum": ["12h", "24h"],
          "default": "12h",
          "description": "Time format preference"
        }
      },
      "returns": {
        "localTime": "string",
        "timezone": "string",
        "utcTime": "string",
        "timestamp": "number"
      },
      "ui": null
    },
    {
      "id": "client.getLocation",
      "name": "Get Location Info",
      "description": "Gets the user's timezone and locale information from their device. Use this when you need to know the user's timezone, locale, or general location information. This does NOT access GPS coordinates.",
      "execution": "client",
      "category": "location",
      "parameters": {},
      "returns": {
        "timezone": "string",
        "locale": "string",
        "timezoneName": "string"
      }
    },
    {
      "id": "client.getDevice",
      "name": "Get Device Info",
      "description": "Gets information about the user's device and browser. Use this when you need to know what platform, browser, or language the user is using.",
      "execution": "client",
      "category": "device",
      "parameters": {},
      "returns": {
        "platform": "string",
        "language": "string",
        "userAgent": "string"
      }
    },
    {
      "id": "server.createContact",
      "name": "Create Contact",
      "description": "Creates a new contact in the CRM system. Use this when the user wants to add a new contact with name and email information.",
      "execution": "server",
      "category": "crm",
      "parameters": {
        "name": {
          "type": "string",
          "required": true,
          "description": "Full name of the contact"
        },
        "email": {
          "type": "string",
          "required": true,
          "description": "Email address of the contact"
        },
        "company": {
          "type": "string",
          "optional": true,
          "description": "Company name"
        },
        "phone": {
          "type": "string",
          "optional": true,
          "description": "Phone number"
        },
        "source": {
          "type": "string",
          "optional": true,
          "enum": ["website", "linkedin", "referral", "cold-call", "event", "email", "other"],
          "description": "Lead source"
        },
        "tags": {
          "type": "array",
          "optional": true,
          "description": "Tags for categorization"
        }
      },
      "returns": {
        "success": "boolean",
        "id": "string",
        "message": "string"
      },
      "ui": {
        "formComponent": "create-contact-form",
        "cardType": "contact",
        "triggerPhrases": ["create contact", "add contact", "new contact"],
        "requiresForm": true,
        "fields": [
          { "name": "name", "label": "Full Name", "type": "text", "required": true, "placeholder": "John Smith" },
          { "name": "email", "label": "Email Address", "type": "email", "required": true, "placeholder": "john@company.com" },
          { "name": "company", "label": "Company", "type": "text", "required": false, "placeholder": "Acme Inc." },
          { "name": "phone", "label": "Phone Number", "type": "tel", "required": false, "placeholder": "+1 (555) 000-0000" },
          { "name": "source", "label": "Lead Source", "type": "select", "required": false },
          { "name": "tags", "label": "Tags", "type": "tags", "required": false }
        ],
        "successMessage": "Contact created successfully",
        "icon": "user-plus"
      }
    },
    {
      "id": "server.listContacts",
      "name": "List Contacts",
      "description": "Retrieves a list of contacts from the CRM. Use this when the user wants to see all contacts or browse the contact list.",
      "execution": "server",
      "category": "crm",
      "parameters": {
        "limit": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of contacts to return"
        }
      },
      "returns": {
        "contacts": "array",
        "count": "number"
      }
    },
    {
      "id": "server.searchContacts",
      "name": "Search Contacts",
      "description": "Searches for contacts by name, email, or company. Use this when the user wants to find specific contacts.",
      "execution": "server",
      "category": "crm",
      "parameters": {
        "query": {
          "type": "string",
          "required": true,
          "description": "Search query string"
        }
      },
      "returns": {
        "contacts": "array",
        "count": "number"
      }
    },
    {
      "id": "server.createOpportunity",
      "name": "Create Opportunity",
      "description": "Creates a new sales opportunity in the pipeline. Use this when the user wants to create a deal, opportunity, or track a potential sale.",
      "execution": "server",
      "category": "sales",
      "parameters": {
        "title": {
          "type": "string",
          "required": true,
          "description": "Opportunity title or deal name"
        },
        "contactId": {
          "type": "string",
          "optional": true,
          "description": "Associated contact ID"
        },
        "contactName": {
          "type": "string",
          "optional": true,
          "description": "Contact name (for display)"
        },
        "company": {
          "type": "string",
          "optional": true,
          "description": "Company name"
        },
        "dealValue": {
          "type": "number",
          "optional": true,
          "description": "Deal value in dollars"
        },
        "stage": {
          "type": "string",
          "enum": ["lead", "qualified", "proposal", "negotiation", "closed_won", "closed_lost"],
          "default": "lead",
          "description": "Current pipeline stage"
        },
        "probability": {
          "type": "number",
          "optional": true,
          "description": "Win probability percentage"
        },
        "expectedCloseDate": {
          "type": "string",
          "optional": true,
          "description": "Expected close date (ISO format)"
        },
        "description": {
          "type": "string",
          "optional": true,
          "description": "Opportunity description"
        },
        "source": {
          "type": "string",
          "optional": true,
          "enum": ["website", "linkedin", "referral", "cold-outreach", "event", "partner", "inbound", "other"],
          "description": "Lead source"
        },
        "tags": {
          "type": "array",
          "optional": true,
          "description": "Tags for categorization"
        }
      },
      "returns": {
        "success": "boolean",
        "id": "string",
        "message": "string"
      },
      "ui": {
        "formComponent": "create-opportunity-form",
        "cardType": "opportunity",
        "triggerPhrases": ["create opportunity", "create deal", "new opportunity", "new deal", "add opportunity"],
        "requiresForm": true,
        "fields": [
          { "name": "title", "label": "Opportunity Title", "type": "text", "required": true, "placeholder": "Enterprise Platform Deal - Acme Corp" },
          { "name": "contactName", "label": "Contact Name", "type": "text", "required": false, "placeholder": "John Smith" },
          { "name": "company", "label": "Company", "type": "text", "required": false, "placeholder": "Acme Corp" },
          { "name": "dealValue", "label": "Deal Value", "type": "currency", "required": false, "placeholder": "50000" },
          { "name": "stage", "label": "Pipeline Stage", "type": "select", "required": true, "default": "lead" },
          { "name": "probability", "label": "Probability", "type": "percentage", "required": false },
          { "name": "expectedCloseDate", "label": "Expected Close Date", "type": "date", "required": false },
          { "name": "description", "label": "Description", "type": "textarea", "required": false },
          { "name": "source", "label": "Lead Source", "type": "select", "required": false },
          { "name": "tags", "label": "Tags", "type": "tags", "required": false }
        ],
        "successMessage": "Opportunity created successfully",
        "icon": "currency-dollar"
      }
    },
    {
      "id": "server.listOpportunities",
      "name": "List Opportunities",
      "description": "Lists opportunities in the sales pipeline. Use this when the user wants to see all deals, opportunities, or pipeline view.",
      "execution": "server",
      "category": "sales",
      "parameters": {
        "stage": {
          "type": "string",
          "enum": ["lead", "qualified", "proposal", "negotiation", "closed_won", "closed_lost", "all"],
          "default": "all",
          "description": "Filter by pipeline stage"
        },
        "limit": {
          "type": "number",
          "default": 10,
          "description": "Maximum number to return"
        }
      },
      "returns": {
        "opportunities": "array",
        "count": "number"
      }
    },
    {
      "id": "server.updateOpportunityStage",
      "name": "Update Opportunity Stage",
      "description": "Moves an opportunity to a different stage in the pipeline. Use this when the user wants to advance or change a deal stage.",
      "execution": "server",
      "category": "sales",
      "parameters": {
        "opportunityId": {
          "type": "string",
          "required": true,
          "description": "Opportunity ID to update"
        },
        "stage": {
          "type": "string",
          "required": true,
          "enum": ["lead", "qualified", "proposal", "negotiation", "closed_won", "closed_lost"],
          "description": "New pipeline stage"
        }
      },
      "returns": {
        "success": "boolean",
        "message": "string"
      }
    },
